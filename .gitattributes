# Ensure consistent LF line endings across Windows and Linux (Ubuntu lab)
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
daemons text eol=lf
Dockerfile* text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.txt text eol=lf

*.pdf binary
*.png binary
*.jpg binary
