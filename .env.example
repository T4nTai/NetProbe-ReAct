# DeepSeek API configuration (OpenAI-compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0

# Agent constraints (per proposal)
MAX_TOOL_CALLS=15

# Containerlab prefix (used in Live mode via docker exec)
CLAB_LAB_NAME=b2-net-rca
CLAB_CONTAINER_PREFIX=clab-b2-net-rca
